# CampusLink server settings. Copy this file to .env and fill it in.
# .env is ignored by git, so your passwords stay on this machine.

# Port for the API (and the site, when serving dist/ with `npm start`)
PORT=3001

# The admin account is created from these on first start.
# Sign in with them at /login.html to open the admin panel.
ADMIN_EMAIL=admin@campuslink.co.ke
ADMIN_PASSWORD=change-this-to-a-long-password

# Set to production when the site is served over HTTPS (makes the sign-in cookie Secure)
NODE_ENV=development

# Where the database and uploads are stored (default: server/data)
# DATA_DIR=/var/lib/campuslink
